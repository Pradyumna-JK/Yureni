# Application
DEALMIND_ENV=development
DEALMIND_API_HOST=0.0.0.0
DEALMIND_API_PORT=8000
DEALMIND_WEB_PORT=5173

# PostgreSQL (used by Phase 2 Docker Compose)
POSTGRES_DB=dealmind
POSTGRES_USER=dealmind
POSTGRES_PASSWORD=change-me-in-local-env
DATABASE_URL=postgresql+psycopg://dealmind:change-me-in-local-env@localhost:5432/dealmind

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_NUM_CTX=16384
# GPT-OSS supports low/medium/high; leave empty for non-thinking models.
OLLAMA_REASONING_EFFORT=low
OLLAMA_FALLBACK_MODEL=gemma3:4b
# Hindsight needs reliable short structured outputs for fact extraction. It can use a
# different local model from the one that writes DealMind's final answers.
HINDSIGHT_LLM_MODEL=gemma3:4b

# Hindsight
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_TIMEOUT_SECONDS=600

# Docker containers reach Ollama through Docker Desktop's host bridge.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_DOCKER_BASE_URL=http://host.docker.internal:11434

# Local neural text-to-speech for Nova voice mode.
# Docker Compose runs Kokoro at http://kokoro-tts:7860 for the API container
# and exposes its local UI/API on http://localhost:7860.
TTS_PROVIDER=kokoro
TTS_BASE_URL=http://kokoro-tts:7860
TTS_MODEL=kokoro
TTS_VOICE=af_heart
